# ============================================
# EXTERNAL SERVICES (ML Backends - Azure Container Apps)
# ============================================

# Backend API URL - Primary URL for server-side API routes
# For Vercel deployment, set in Vercel Dashboard environment variables
# Example: https://ml-api.xxx.centralindia.azurecontainerapps.io
BACKEND_API_URL="http://localhost:8000"

# ML Backend URL - For client-side calls (if any)
NEXT_PUBLIC_ML_API_URL="http://localhost:8000"

# Vision Backend URL - For X-ray analysis
NEXT_PUBLIC_VISION_API_URL="http://localhost:8001"

# ============================================
# NEXT.JS SETTINGS
# ============================================

# Application URL - Vercel auto-sets this, but you can override
# For custom domain: https://curasense.yourdomain.com
NEXTAUTH_URL="http://localhost:3000"

# Environment
NODE_ENV="development"

# ============================================
# VERCEL DEPLOYMENT NOTES
# ============================================
# 
# Required Environment Variables for Vercel:
# 1. DATABASE_URL - Your Neon DB pooled connection string
# 2. JWT_SECRET - Generate a secure 64+ character string
# 3. JWT_REFRESH_SECRET - Another secure 64+ character string
# 4. BACKEND_API_URL - URL of your deployed ML backend (Azure Container Apps)
# 5. NEXT_PUBLIC_ML_API_URL - URL of your deployed ML backend
# 6. NEXT_PUBLIC_VISION_API_URL - URL of your deployed Vision backend
#
# Optional:
# - ACCESS_TOKEN_EXPIRES_IN (default: 15m)
# - REFRESH_TOKEN_EXPIRES_IN (default: 7d)
#
# Note: ML backends are deployed on Azure Container Apps.
# See azure_deployment_guide.md for setup instructions.
